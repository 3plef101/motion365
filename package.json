{
  "name": "motion365",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,render -c cyan,green \"npm:dev:web\" \"npm:dev:render\"",
    "dev:web": "vite",
    "dev:render": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.mjs --production",
    "render": "remotion render src/remotion.tsx FieldnotesQuarterly out/fieldnotes.mp4 --codec=h264 --crf=16"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.538",
    "@remotion/cli": "^4.0.538",
    "@remotion/player": "^4.0.538",
    "@remotion/renderer": "^4.0.538",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.538",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
